# Copy to .env in the repository root. Use your own provider keys.
# Configure one provider, or both to enable fallback.
INFERCOM_API_KEY=
INFERCOM_MODEL=gpt-oss-120b

GEMINI_API=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: browser login for Upwork
# UPWORK_EMAIL=
# UPWORK_PASSWORD=
# PROXY_URL=

# Optional: absolute directory for local state, shared by the web server and MCP
# JOB_STUDIO_DATA=C:/Projects/job-studio-data
